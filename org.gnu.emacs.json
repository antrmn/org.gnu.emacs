{
    "app-id": "org.gnu.emacs",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "emacs",
    "rename-icon": "emacs",
    "rename-appdata-file": "emacs.metainfo.xml",
    "rename-desktop-file": "emacs.desktop",
    "build-options" : {
        "env" : {
            "V" : "1",
            "BASH_COMPLETIONSDIR" : "/app/share/bash-completion/completions",
            "MOUNT_FUSE_PATH" : "../tmp/"
        }
    },
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=pulseaudio",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--filesystem=host",
        "--filesystem=/tmp",
        "--filesystem=/var/tmp",
        "--filesystem=~/.local/share/flatpak",
        "--filesystem=/var/lib/flatpak",
        "--talk-name=org.freedesktop.Flatpak",
        "--allow=devel",
        "--device=dri",
        "--system-talk-name=org.freedesktop.PolicyKit1",
        "--system-talk-name=org.freedesktop.Flatpak.SystemHelper"
    ],
    "modules": [
        "./foundry/libfoundry.json",
        "libgccjit.json",
        {
            "name": "tree-sitter",
            "buildsystem": "simple",
            "build-commands": [
                "PREFIX=\"/app\" make",
                "PREFIX=\"/app\" make install"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/tree-sitter/tree-sitter.git",
                    "tag": "v0.26.8"
                }
            ],
            "cleanup": [
                "/include",
                "/lib/pkgconfig",
                "/lib/*.a"
            ]

        },
        {
            "name": "emacs",
            "buildsystem": "autotools",
            "config-opts": [
                "--with-gnutls",
                "--with-tree-sitter",
                "--with-pgtk",
                "--with-native-compilation=aot"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "git://git.git.savannah.gnu.org/emacs.git",
		            "branch": "master"
                },
                {
                    "type": "patch",
                    "path": "emacs-metainfo.patch"
                }
            ],
            "cleanup": [
                "/include",
                "/lib/systemd",
                "/share/icons/hicolor/scalable/apps/emacs.ico",
                "/share/icons/hicolor/scalable/mimetypes/emacs-document.svg",
                "/share/icons/hicolor/scalable/mimetypes/emacs-document23.svg"
            ]
        }
    ]
}
